# 로컬 실행(`npm run dev`)용 환경 변수 예시. 값은 비워 두었습니다.
# 이 파일을 .env 로 복사해 채우거나 `vercel env pull` 로 받습니다. .env 는 커밋되지 않습니다.

# Upstash Redis. 비우면 로컬에서는 메모리에 저장합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 사용자 API 키(Gemini·Claude)를 암호화하는 비밀값. 키를 저장하려면 필수입니다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=

# 선택
GEMINI_MODEL=
CLAUDE_MODEL=
CLAUDE_EFFORT=
SESSION_SECRET=
